Adafruit_SSD1306 display(128, 64, &Wire, -1);
Adafruit_MPU6050 mpu;

enum GameState {IDLE, CHOOSING, BATTLE, LOSE, WIN};
enum EvolutionState {BLOB, EVOLVING, BLOCKY1, BLOCKY2, BLOCKY3, SPIKY1, SPIKY2, SPIKY3};
GameState activeState = IDLE;
EvolutionState petState = BLOB;
int BattlesWon = 0;
int aiDifficulty = 1;
int defaultSquare = 4; // 4 is the center square in a game of tic tac toe, if you go 0 to 8.
char Board[9] = {' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' '};
bool isPlayerTurn = true;

unsigned long turnTimeLimit = 10000;
unsigned long TurnTimerStart = 0;

float currentTemperature = 24.0f;
unsigned long lastDHTReadTime = 0;

const uint8_t* getActivePetSprite() {
  switch(petState){
    case BLOCKY1: return Blocky_Evo1;
    case BLOCKY2: return Blocky_Evo2;
    case BLOCKY3: return Blocky_Evo3;
    case SPIKY1: return Spiky_Evo1;
    case SPIKY2: return Spiky_Evo2;
    case SPIKY3: return Spiky_Evo3;
    case BLOB:
    case CHOOSING:
    default:  return Blobb;
  }
}

//============================================================================
// AI (as in the bot, not that this is made by AI)
char checkWinCondition() {
  const int winPatterns[8][3] = {
    {0,1,2}, {3,4,5}, {6,7,8}, // Rows
    {0,3,6}, {1,4,7}, {2,5,8}, // Cols
    {0,4,8}, {2,4,6}           // Diagonals
  };
  for(int i = 0; i < 8; i++) {
    if(Board[winPatterns[i][0]] != ' ' &&
       Board[winPatterns[i][0]] == Board[winPatterns[i][1]] &&
       Board[winPatterns[i][0]] == Board[winPatterns[i][2]]) {
      return Board[winPatterns[i][0]];
    }
  }
  // Check for a tie match
  bool openSpotFound = false;
  for(int i = 0; i < 9; i++) { if(Board[i] == ' ') openSpotFound = true; }
  return openSpotFound ? ' ' : 'T';
}

void processBattleEnd(char winner) {
  if (winner == 'X') {
    BattlesWon++;
    aiDifficulty++;
    
    // Evaluate evolution gates
    if (petState == BLOB && BattlesWon >= 1) {
      activeState = CHOOSING;
    } 
    
    else if (petState == BLOCKY1 && BattlesWon >= 3) {
      petState = BLOCKY2;
      BattlesWon = 0;
      activeState = WIN;
    } else if (petState == BLOCKY2 && BattlesWon >= 5) {
      petState = BLOCKY3;
      BattlesWon = 0;
      activeState = WIN;
    }

    else if (petState == SPIKY1 && BattlesWon >= 3) {
      petState = SPIKY2;
      BattlesWon = 0;
      activeState = WIN;
    } else if (petState == SPIKY2 && BattlesWon >= 5) {
      petState = SPIKY3;
      BattlesWon = 0;
      activeState = WIN;

    } 
    else {
      activeState = WIN;
    }
  }
   else {
    activeState = LOSE;
  }
}

void executeBotMove() {
  if (activeState != BATTLE || isPlayerTurn) return;
  bool isSmartAI = false;
  if (petState == BLOCKY1 || petState == BLOCKY2 || petState == BLOCKY3) {
    isSmartAI = true; 
  } else if (aiDifficulty > 3) {
    isSmartAI = true; 
  }
  
  if (isSmartAI) {
    for(int i = 0; i < 9; i++) {
      if(Board[i] == ' ') {
        Board[i] = 'X'; 
        if(checkWinCondition() == 'X') { 
          Board[i] = 'O'; isPlayerTurn = true; TurnTimerStart = millis(); return; 
        }
        Board[i] = ' ';
      }
    }
  }
  for (int i = 0; i < 9; i++) {
    if (Board[i] == ' ') {
      Board[i] = 'O';
      isPlayerTurn = true;
      TurnTimerStart = millis();
      return;
    }
  }
}

void processTiltControls(float mpuX, float mpuY) {
  if (activeState != BATTLE || !isPlayerTurn) return;
  static unsigned long lastMove = 0;
  if (millis() - lastMove < 300) return; // Cursor step speed limiter

  int row = defaultSquare / 3; int col = defaultSquare % 3;
  if (mpuX > 2.5f && col < 2)  { col++; lastMove = millis(); }
  if (mpuX < -2.5f && col > 0) { col--; lastMove = millis(); }
  if (mpuY > 2.5f && row > 0)  { row--; lastMove = millis(); }
  if (mpuY < -2.5f && row < 2) { row++; lastMove = millis(); }
  defaultSquare = (row * 3) + col;
}

void drawGameBoard() {
  display.clearDisplay();
  
  // Draws the 3x3 Tic-Tac-Toe line boundaries on the left side of screen
  display.drawFastVLine(26, 0, 48, SSD1306_WHITE);
  display.drawFastVLine(46, 0, 48, SSD1306_WHITE);
  display.drawFastHLine(6, 16, 60, SSD1306_WHITE);
  display.drawFastHLine(6, 32, 60, SSD1306_WHITE);

  // Populates board cells with X and O text characters
  for (int i = 0; i < 9; i++) {
    int r = i / 3; int c = i % 3;
    int xPos = 13 + (c * 20); int yPos = 4 + (r * 16);
    
    if (Board[i] != ' ') {
      display.setCursor(xPos, yPos);
      display.print(Board[i]);
    }
    // Renders the active blinking selector frame over current cell
    if (i == defaultSquare && (millis() / 250) % 2 == 0) {
      display.drawRect(xPos - 4, yPos - 2, 14, 12, SSD1306_WHITE);
    }
  }

  // Renders the countdown timer bar at the very bottom
  long remaining = turnTimeLimit - (millis() - TurnTimerStart);
  if (remaining < 0) remaining = 0;
  int barWidth = map(remaining, 0, turnTimeLimit, 0, 128);
  display.fillRect(0, 58, barWidth, 4, SSD1306_WHITE);

  // Status interface panel data on the right half of the display screen
  display.setCursor(75, 4);  display.print("LVL: "); display.print(aiDifficulty);
  display.setCursor(75, 18); display.print(isPlayerTurn ? "YOUR" : "BOSS");
  display.setCursor(75, 28); display.print("TURN");
  display.display();
}

void displayBranchChoicePanel() {
  static bool choiceBlocky = true;
  display.clearDisplay();
  display.setCursor(0, 0); display.println("BOSS DEFEATED!\nCHOOSE YOUR BRANCH:");
  
  if (digitalRead(BUTTON_ONE_PIN) == LOW) { choiceBlocky = !choiceBlocky; delay(200); }

  display.setCursor(0, 24);
  display.println(choiceBlocky ? "> BLOCKY (+Time/-AI)" : "  BLOCKY (+Time/-AI)");
  display.println(!choiceBlocky ? "> SPIKY  (-Time/+AI)" : "  SPIKY  (-Time/+AI)");
  display.display();

  if (digitalRead(BUTTON_TWO_PIN) == LOW) {
    if (choiceBlocky) {
      petState = BLOCKY1; 
      if(isPlayingDemo) {
        turnTimeLimit = 160000; //its super hard to work with the wokwi gyroscope, so we'll give the player quadruple time if they're using it.
      }
      else{ turnTimeLimit = 40000;}
    } else {
      petState = SPIKY1;
      if(isPlayingDemo) {
        turnTimeLimit = 80000;
      }
      else{ turnTimeLimit = 20000;}
    }
    BattlesWon = 0; activeState = IDLE; delay(300);
  }
}


// ===========================================================================================
// setup and loop

void setup() {
  Serial.begin(115200);
  pinMode(BUTTON_ONE_PIN, INPUT_PULLUP);
  pinMode(BUTTON_TWO_PIN, INPUT_PULLUP);
  
  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);
  display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS);
  mpu.begin(MPU6050_ADDRESS);
  
  display.clearDisplay();
  display.display();
}

void loop() {
  if (millis() - lastDHTReadTime >= 2000) {
    lastDHTReadTime = millis();
    float t = dht.readTemperature();
    if (!isnan(t)) {
      currentTemperature = t; // Live temperature tracking update
    }
  }

  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);

  switch (activeState) {
    case CHOOSING:
      displayBranchChoicePanel();
      break;

    case BATTLE:
      processTiltControls(a.acceleration.x, a.acceleration.y);
      drawGameBoard();
      unsigned long activeTimeLimit = (currentTemperature > 29.0f || currentTemperature < 17.0f) ? (turnTimeLimit / 2) : turnTimeLimit;
      // Turn timer handling
      if (isPlayerTurn && (millis() - TurnTimerStart >= activeTimeLimit)) {
        processBattleEnd('O'); // Lose instantly if timer hits zero
      }
      
      // Confirm piece placement with Button 1
      if (isPlayerTurn && digitalRead(BUTTON_ONE_PIN) == LOW) {
        if (Board[defaultSquare] == ' ') {
          Board[defaultSquare] = 'X';
          char res = checkWinCondition();
          if (res != ' ') { processBattleEnd(res); } 
          else { isPlayerTurn = false; }
          delay(250);
        }
      }
      
      // Execute enemy move
      if (!isPlayerTurn) {
        delay(600); // Fakes the boss thinking loop
        executeBotMove();
        char res = checkWinCondition();
        if (res != ' ') { processBattleEnd(res); }
      }
      break;

    case LOSE:
      display.clearDisplay(); 
      display.setTextSize(1);
      display.setTextColor(SSD1306_WHITE);
      display.setCursor(10, 20); 
      display.println("YOU DIED. GAME OVER");
      display.setCursor(15, 44); 
      display.println("Press B1 to Reset"); 
      display.display();
      
      if (digitalRead(BUTTON_ONE_PIN) == LOW) { 
        petState = BLOB; 
        aiDifficulty = 1; 
        activeState = IDLE; 
        delay(300); 
      }
      break;

    case WIN:
      display.clearDisplay(); 
      display.setTextSize(1);
      display.setTextColor(SSD1306_WHITE);
      display.setCursor(15, 12); 
      display.println("VICTORY! EVOLVED!");
      display.drawBitmap(48, 28, getActivePetSprite(), 32, 32, SSD1306_WHITE); 
      display.display();
      delay(4000); 
      activeState = IDLE;
      break;

    case IDLE:
    default:
      display.clearDisplay();
      display.drawBitmap(48, 4, getActivePetSprite(), 32, 32, SSD1306_WHITE);
      display.setTextSize(1);
      display.setTextColor(SSD1306_WHITE);
      display.setCursor(0, 44); display.print("Wins: "); display.print(BattlesWon);
      display.setCursor(0, 54); display.print("Press B1 to Fight Boss"); 
      display.display();
      
      if (digitalRead(BUTTON_ONE_PIN) == LOW) {
        for(int i = 0; i < 9; i++) Board[i] = ' ';
        defaultSquare = 4; 
        isPlayerTurn = true; 
        TurnTimerStart = millis();
        activeState = BATTLE; 
        delay(300);
      }
      break;
  }
}
